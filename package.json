{
  "name": "openclaw-dexi",
  "version": "0.1.0",
  "type": "module",
  "description": "Dexi memory plugin for OpenClaw — your notes library as the agent's long-term memory (auto-recall, dexi_* tools, /remember, optional session digest)",
  "license": "MIT",
  "author": {
    "name": "Dexi",
    "email": "team@dexi.net",
    "url": "https://dexi.net"
  },
  "homepage": "https://docs.dexi.net/mcp/openclaw-plugin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dexi/openclaw-plugin.git"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "memory",
    "dexi",
    "notes",
    "mcp"
  ],
  "engines": {
    "node": ">=22"
  },
  "files": [
    "README.md",
    "LICENSE",
    "openclaw.plugin.json",
    "index.ts",
    "src",
    "skills",
    "dist"
  ],
  "scripts": {
    "build": "esbuild index.ts --bundle --format=esm --platform=node --target=es2022 --external:openclaw --external:openclaw/* --external:@modelcontextprotocol/sdk --external:@modelcontextprotocol/sdk/* --external:typebox --external:typebox/* --outfile=dist/index.js",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "typebox": "^1.3.3"
  },
  "peerDependencies": {
    "openclaw": ">=2026.5.7"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "esbuild": "^0.27.2",
    "openclaw": "2026.7.1-2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.5.7",
      "minGatewayVersion": "2026.5.7"
    },
    "build": {
      "openclawVersion": "2026.7.1-2"
    }
  }
}
